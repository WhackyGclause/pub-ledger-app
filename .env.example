# Copy this file to .env and fill in your own Supabase project values.
# Find these in your Supabase project: Settings → API (or Settings → API Keys).

# Project URL, e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=

# The secret "service_role" key (or the newer "Secret key" / sb_secret_...
# from Settings → API Keys → Publishable and secret API keys).
# NOT the anon/publishable key. This bypasses Row Level Security and must
# NEVER be exposed to a browser or committed to git — it is only read here,
# on the backend.
SUPABASE_SERVICE_KEY=

# Optional: change the local port the server runs on.
PORT=3000
